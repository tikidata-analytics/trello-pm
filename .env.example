# ==============================================================================
# Trello PM Skill Configuration
# Copy this file to `.env` in your workspace root and fill in your credentials.
# NEVER commit `.env` to version control.
# ==============================================================================

# 1. Get your API key at: https://trello.com/power-ups/admin
TRELLO_API_KEY=your_trello_api_key_here

# 2. Generate a personal token using your API key (see README.md for the exact URL)
TRELLO_TOKEN=your_trello_token_here

# 3. Target Trello Board ID or full board URL
#    Example short ID : AbCdEf12
#    Example full URL : https://trello.com/b/AbCdEf12/engineering-roadmap
TRELLO_BOARD_ID=your_board_id_or_url_here

# 4. Optional: Customize your board's list names (case-insensitive)
TRELLO_DOING_LIST=Doing
TRELLO_DONE_LIST=Done
TRELLO_TESTING_LIST=Testing

# 5. Optional: Override the directory containing your cloned repositories
# TRELLO_REPOS_DIR=./repos
